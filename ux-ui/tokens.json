{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "Вектор ЕГЭ",
  "styleSystem": "hh.ru inspired contrast design system",
  "themes": {
    "light": {
      "bg": "#F4F5F7",
      "surface": "#FFFFFF",
      "surface2": "#F2F3F6",
      "ink": "#141517",
      "ink2": "#3E434D",
      "muted": "#6E7482",
      "line": "#E5E8EE",
      "lineStrong": "#CFD5E0",
      "accent": "#0070FF",
      "accentHover": "#005BD1",
      "accentSoft": "#EBF3FF",
      "notificationOrange": "#F97316",
      "notificationOrangeSoft": "#FFF4EC",
      "confirmGreen": "#16A34A",
      "confirmGreenSoft": "#ECFDF3",
      "proPurple": "#7C3AED",
      "proPurpleSoft": "#F3EEFF",
      "badRed": "#DC2626",
      "badRedSoft": "#FEF2F2"
    },
    "dark": {
      "bg": "#000000",
      "surface": "#16181D",
      "surface2": "#22252E",
      "ink": "#FFFFFF",
      "ink2": "#D4D8E2",
      "muted": "#8B909D",
      "line": "#282B36",
      "lineStrong": "#373B49",
      "accent": "#1D7BFF",
      "accentHover": "#0D67E8",
      "accentSoft": "#102548",
      "notificationOrange": "#FB923C",
      "notificationOrangeSoft": "#2E1909",
      "confirmGreen": "#22C55E",
      "confirmGreenSoft": "#0C2B17",
      "proPurple": "#A78BFA",
      "proPurpleSoft": "#21153B",
      "badRed": "#FF4D5E",
      "badRedSoft": "#3A171C"
    }
  },
  "typography": {
    "display": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "body": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "mono": "IBM Plex Mono, ui-monospace, Cascadia Mono, Consolas, monospace"
  },
  "radii": {
    "cardPx": 16,
    "controlPx": 12,
    "pillPx": 999
  },
  "controls": {
    "iconSizesPx": { "standard": 38, "compact": 32 },
    "strokeWidthPx": 1.8,
    "calendarRailTopClearancePx": 6,
    "sliderHours": { "min": 10, "max": 20, "step": 1, "variants": ["clean", "ticks", "ruler"] },
    "priceStepRub": 100
