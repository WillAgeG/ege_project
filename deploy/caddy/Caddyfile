{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$APP_DOMAIN} {
	header -Server

	# Swagger/OpenAPI скрыты в проде (дублирующая защита на уровне прокси)
	@api_docs_blocked {
		path /docs /docs/* /redoc /redoc/* /openapi.json
	}
	handle @api_docs_blocked {
		respond 404
	}

	# Webhook ЮKassa (платежи и выплаты) открыт только для официальных IPv4/IPv6-сетей ЮKassa
	@yookassa_denied {
		path /api/payments/yookassa/webhook /api/payouts/yookassa/webhook
		not remote_ip 185.71.76.0/27 185.71.77.0/27 77.75.153.0/25 77.75.154.128/25 77.75.156.11/32 77.75.156.35/32 2a02:5180::/32
	}
	handle @yookassa_denied {
		respond 403
	}

	# SSE и стриминг ИИ передаются без буферизации
	handle /api/realtime/stream* {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}

	handle /api/ai/* {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}

	handle /api/realtime/ws* {
		reverse_proxy app:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy app:8000
	}
}

{$ADMIN_DOMAIN} {
	basic_auth {
		{$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	reverse_proxy admin:8501 {
		flush_interval -1
	}
}
