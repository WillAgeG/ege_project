# База данных SQLite (на Railway при подключённом Volume на /data определяется автоматически через RAILWAY_VOLUME_MOUNT_PATH)
# DB_PATH=.local_data/app.db

# Опциональный инвайт-код для регистрации (если пусто — регистрация открыта для всех)
# INVITE_CODE=med2027

# Ограничение числа аккаунтов (0 = без ограничения)
# MAX_USERS=10

# ИИ-провайдер: auto | gemini | openai | anthropic | openrouter
AI_PROVIDER=auto

# Достаточно указать ключ одного из провайдеров:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Опционально переопределить модели (иначе берутся значения по умолчанию для провайдера)
# AI_MODEL=
# AI_MODEL_COMPLEX=
# AI_BASE_URL=
